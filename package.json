{
  "name": "codeup-py-100",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "postinstall": "node scripts/copy-runtime.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/copy-runtime.mjs && vite build",
    "preview": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "test": "tsx --test tests/*.test.ts",
    "test:solutions": "python3 scripts/validate-solutions.py",
    "test:e2e": "playwright test"
  },
  "dependencies": { "monaco-editor": "0.56.0", "pyodide": "314.0.6" },
  "overrides": { "dompurify": "3.4.15" },
  "devDependencies": { "@playwright/test": "^1.58.2", "@types/node": "^22.19.0", "tsx": "^4.21.0", "typescript": "^5.9.3", "vite": "8.2.2", "wrangler": "4.129.0" }
}
